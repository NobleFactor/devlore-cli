#!/usr/bin/env bash

# SPDX-License-Identifier: Apache-2.0
# Copyright Noble Factor. All rights reserved.

# git-scenario - a git-supporting command the base ships

# shellcheck source=Declare-BashScript
source "$(dirname "$0")/Declare-BashScript" "$0" "help" "h" "$@"

###########
# Arguments
###########

declare -r synopsis="git-scenario [-h|--help]"
eval set -- "$script_arguments"

while :; do
    case $1 in
        -h | --help)
            usage "$synopsis" # does not return
            ;;
        --)
            shift 1
            break
            ;;
        *)
            error $EX_USAGE "Unrecognized option: $1"
            ;;
    esac
done

###########
# Main
###########

note "git-scenario: a git-supporting command the base ships"
printf '%s\n' "base:git-scenario"
