_Declare-BashScript() {
    local -a opts
    opts=(
        '(-h --help)'{-h,--help}'[Show usage information and exit]'
        ':script_path:_files'
        ':long_options:'
        ':short_options:'
        '*:arguments:'
    )

    _arguments -s -S $opts
}

_Declare-BashScript "$@"
