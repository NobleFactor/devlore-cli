#!/usr/bin/env bash

# SPDX-License-Identifier: Apache-2.0
# Copyright Noble Factor. All rights reserved.

# git-a - a git-supporting personal command

# shellcheck source=Declare-BashScript
source "$(dirname "$0")/Declare-BashScript" "$0" "help" "h" "$@"

###########
# Arguments
###########

declare -r synopsis="git-a [-h|--help]"
eval set -- "$script_arguments"

while :; do
    case $1 in
        -h | --help)
            usage "$synopsis" # does not return
            ;;
        --)
            shift 1
            break
            ;;
        *)
            error $EX_USAGE "Unrecognized option: $1"
            ;;
    esac
done

###########
# Main
###########

note "git-a: a git-supporting personal command"
printf '%s\n' "personal:git-a"
