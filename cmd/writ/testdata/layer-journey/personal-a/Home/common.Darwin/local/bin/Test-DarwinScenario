# Test-DarwinScenario - check the Darwin scenario state

# shellcheck source=Declare-BashScript
source "$(dirname "$0")/Declare-BashScript" "$0" "help" "h" "$@"
require_darwin

###########
# Arguments
###########

declare -r synopsis="Test-DarwinScenario [-h|--help]"
eval set -- "$script_arguments"

while :; do
    case $1 in
        -h | --help)
            usage "$synopsis" # does not return
            ;;
        --)
            shift 1
            break
            ;;
        *)
            error $EX_USAGE "Unrecognized option: $1"
            ;;
    esac
done

###########
# Main
###########

note "Test-DarwinScenario: check the Darwin scenario state"
printf '%s\n' "personal:Test-DarwinScenario"
