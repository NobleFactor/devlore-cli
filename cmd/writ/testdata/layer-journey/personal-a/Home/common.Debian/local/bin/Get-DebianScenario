#!/usr/bin/env bash

# SPDX-License-Identifier: Apache-2.0
# Copyright Noble Factor. All rights reserved.

# Get-DebianScenario - report the Debian scenario state

# shellcheck source=Declare-BashScript
source "$(dirname "$0")/Declare-BashScript" "$0" "help" "h" "$@"
require_linux

###########
# Arguments
###########

declare -r synopsis="Get-DebianScenario [-h|--help]"
eval set -- "$script_arguments"

while :; do
    case $1 in
        -h | --help)
            usage "$synopsis" # does not return
            ;;
        --)
            shift 1
            break
            ;;
        *)
            error $EX_USAGE "Unrecognized option: $1"
            ;;
    esac
done

###########
# Main
###########

note "Get-DebianScenario: report the Debian scenario state"
printf '%s\n' "personal:Get-DebianScenario"
