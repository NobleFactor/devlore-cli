{
  "organization": {
    "secrets": ["NOBLEFACTOR_AUTOMATION_APP_ID", "NOBLEFACTOR_AUTOMATION_APP_PRIVATE_KEY"],
    "permissions": {
      "contents": "write",
      "issues": "write",
      "metadata": "read",
      "pull_requests": "write",
      "organization_projects": "write",
      "issue_fields": "read"
    }
  },
  "user": {
    "secrets": ["ADD_TO_PROJECT_PAT"],
    "scopes": ["repo", "project"]
  },
  "margin_days": 14,
  "assignee": "David-Noble-at-work",
  "guide": "https://github.com/NobleFactor/noblefactor-engprod/blob/develop/docs/reference/issue-tracking-credentials.md"
}
